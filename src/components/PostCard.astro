---
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const url = `/${post.id}/`;
const date = post.data.publishedAt.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const words = post.body?.trim().split(/\s+/).length ?? 0;
const minutes = Math.max(1, Math.ceil(words / 220));
---
<article class="post-card">
  <a class="post-card-media" href={url} tabindex="-1" aria-hidden="true"><img src={post.data.cover} alt={post.data.coverAlt} width="1200" height="630" loading="lazy" decoding="async" /></a>
  <div class="post-card-body">
    <div class="post-meta"><span class="post-category">{post.data.category}</span><span aria-hidden="true">•</span><time datetime={post.data.publishedAt.toISOString()}>{date}</time><span aria-hidden="true">•</span><span>{minutes} min read</span></div>
    <h3><a href={url}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <a class="text-link" href={url} aria-label={`Read ${post.data.title}`}>Read article <span aria-hidden="true">→</span></a>
  </div>
</article>
